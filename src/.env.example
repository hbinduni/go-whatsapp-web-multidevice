# Application Settings
APP_PORT=3000
APP_DEBUG=false
APP_OS=Chrome
APP_BASE_PATH=
APP_TRUSTED_PROXIES=0.0.0.0/0

# Authentication (REQUIRED for secure access)
# JWT secret for signing tokens - Generate with: openssl rand -base64 32
AUTH_SECRET=
# Admin username (default: admin)
AUTH_USERNAME=admin
# Password hash - Generate with: bun ../scripts/hash-password.ts
AUTH_PASSWORD_HASH=
# Token expiry (optional, defaults: 1h access, 168h refresh)
# AUTH_ACCESS_TOKEN_EXPIRY=1h
# AUTH_REFRESH_TOKEN_EXPIRY=168h

# Database Configuration (PostgreSQL only)
# All API routes use multi-client pattern: /api/:phone/*
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp?sslmode=disable

# WhatsApp Clients (comma-separated phone numbers)
WHATSAPP_CLIENTS=6281234567890,6289876543210

# WhatsApp Settings
WHATSAPP_ACCOUNT_VALIDATION=true
WHATSAPP_AUTO_MARK_READ=false
WHATSAPP_AUTO_REPLY="Auto reply message"
WHATSAPP_AUTO_DOWNLOAD_MEDIA=true
WHATSAPP_CHAT_STORAGE=true
WHATSAPP_WEBHOOK=https://example.com/webhook1,https://example.com/webhook2
WHATSAPP_WEBHOOK_SECRET=super-secret-key
WHATSAPP_WEBHOOK_INSECURE_SKIP_VERIFY=false

# History Sync Configuration
WHATSAPP_HISTORY_SYNC_ENABLED=true
WHATSAPP_HISTORY_SYNC_ON_LOGIN=true
WHATSAPP_HISTORY_SYNC_MAX_DAYS=90

# S3/MinIO Storage Configuration
# Works with: AWS S3, MinIO, DigitalOcean Spaces, Wasabi, Backblaze B2, etc.
# For AWS S3: S3_ENDPOINT=https://s3.amazonaws.com, S3_FORCE_PATH_STYLE=false
# For MinIO: S3_ENDPOINT=https://your-minio-server.com, S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=your-access-key-id
S3_BUCKET=whatsapp-media
S3_ENDPOINT=https://s3.amazonaws.com
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=your-secret-access-key
# For PUBLIC bucket: S3_USE_SERVER_PROXY=false (direct URLs)
# For PRIVATE bucket: S3_USE_SERVER_PROXY=true (server proxies downloads)
S3_USE_SERVER_PROXY=false
