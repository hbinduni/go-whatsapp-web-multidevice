# Application Settings
APP_PORT=3000
APP_DEBUG=false
APP_OS=Chrome
APP_BASIC_AUTH=user1:pass1,user2:pass2
APP_BASE_PATH=
APP_TRUSTED_PROXIES=0.0.0.0/0

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
#
# Choose ONE of the following modes:
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ SINGLE-CLIENT MODE (SQLite) - Default                                       │
# │ Uses local SQLite databases, one WhatsApp account per instance             │
# └─────────────────────────────────────────────────────────────────────────────┘
DB_URI="file:storages/whatsapp.db?_foreign_keys=on"
DB_KEYS_URI="file::memory:?cache=shared&_foreign_keys=on"

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ MULTI-CLIENT MODE (PostgreSQL) - Recommended for multiple accounts         │
# │ Set DATABASE_URL to enable multi-client mode with PostgreSQL               │
# │ Routes become: /api/:phone/* (e.g., /api/6281234567890/send/message)      │
# └─────────────────────────────────────────────────────────────────────────────┘
# DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp?sslmode=disable

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ MULTI-CLIENT with SQLite (Alternative - Limited)                           │
# │ Set WHATSAPP_CLIENTS with comma-separated phone numbers                    │
# │ Note: PostgreSQL is recommended for better multi-client isolation          │
# └─────────────────────────────────────────────────────────────────────────────┘
# WHATSAPP_CLIENTS=+6281234567890,+6289876543210

# WhatsApp Settings
WHATSAPP_ACCOUNT_VALIDATION=true
WHATSAPP_AUTO_MARK_READ=false
WHATSAPP_AUTO_REPLY="Auto reply message"
WHATSAPP_AUTO_DOWNLOAD_MEDIA=true
WHATSAPP_CHAT_STORAGE=true
# Comma-separated webhook URLs for event notifications
WHATSAPP_WEBHOOK=https://example.com/webhook1,https://example.com/webhook2
WHATSAPP_WEBHOOK_SECRET=super-secret-key
WHATSAPP_WEBHOOK_INSECURE_SKIP_VERIFY=false

# History Sync Configuration
# Enable or disable history sync processing
WHATSAPP_HISTORY_SYNC_ENABLED=true
# Automatically process history sync on login
WHATSAPP_HISTORY_SYNC_ON_LOGIN=true
# Maximum days of history to sync (90 = 3 months, 365 = 1 year, 730 = 2 years, 1095 = 3 years, -1 = all available)
WHATSAPP_HISTORY_SYNC_MAX_DAYS=90

# S3/MinIO Storage Configuration (required for media storage)
# Works with: AWS S3, MinIO, DigitalOcean Spaces, Wasabi, Backblaze B2, etc.
# IMPORTANT: Bucket must be created manually before starting the application
# If S3 is not configured, media download/upload features will be disabled
#
# For AWS S3:
#   S3_ENDPOINT=https://s3.amazonaws.com (or region-specific: https://s3.us-east-1.amazonaws.com)
#   S3_FORCE_PATH_STYLE=false
#
# For MinIO:
#   S3_ENDPOINT=https://your-minio-server.com
#   S3_FORCE_PATH_STYLE=true
#
S3_ACCESS_KEY_ID=your-access-key-id
S3_BUCKET=whatsapp-media
S3_ENDPOINT=https://s3.amazonaws.com
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Bucket Access Mode:
# - For PUBLIC bucket: Set S3_USE_SERVER_PROXY=false (direct URLs, faster)
#   Make bucket public with: mc anonymous set download s3/bucket-name
# - For PRIVATE bucket: Set S3_USE_SERVER_PROXY=true (server proxies downloads with authentication)
S3_USE_SERVER_PROXY=false
